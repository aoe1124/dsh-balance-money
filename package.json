{
  "name": "dsh-balance-money",
  "version": "0.1.5",
  "description": "DeepSeek Harness 极简余额、今日消费与峰谷倒计时",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "jsdom": "26.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aoe1124/dsh-balance-money.git"
  },
  "homepage": "https://github.com/aoe1124/dsh-balance-money#readme",
  "bugs": {
    "url": "https://github.com/aoe1124/dsh-balance-money/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "balance"
  ],
  "author": "aoe1124"
}
